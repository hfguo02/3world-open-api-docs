{
  "openapi": "3.0.1",
  "info": {
    "title": "3world Passkey 接入 API（对接总表）",
    "version": "1.2.0",
    "description": "本次 Passkey 接入前后端对接的**全部接口**，按用途分 4 组，标注【新增】/【修改】/【历史复用】及使用时机。每个出入参均标注枚举值与精简含义。\n\n通用约定：\n- 鉴权：除登录组外，请求头带 `3world-token: {tokenValue}`。\n- 响应统一包裹 Result，`code=\"200\"` 成功；命中风控时 code 非 200 且 risk 携带风控单。\n- 二级认证(safe)唯一开启入口是 `/security/verify`(openSafe)，`@SaCheckSafe` 校验，靠同一登录 token 关联。\n- 高风险业务验证：verify/start、verify/finish 传 riskConsoleNo=风控单写回模式(本次新增)；不传=safe 模式。"
  },
  "servers": [{ "url": "{{baseUrl}}", "description": "环境地址，在 Apifox 环境变量配置" }],
  "tags": [
    { "name": "1. Passkey 登录【新增】", "description": "无密码登录三步（免登录）" },
    { "name": "2. Passkey 管理【新增/修改】", "description": "绑定、列表、编辑名称、撤销、业务验证（需登录）" },
    { "name": "3. 2FA 与账号登录【历史复用】", "description": "绑定/解绑前置、passkey 失败兜底、账号密码登录兜底、用户信息" },
    { "name": "4. 业务接口·触发风控【历史复用】", "description": "提现/出金/KYT 等；命中风控后 passkey 作为 2FA 接入" }
  ],
  "paths": {
    "/user/login/passkey/start": {
      "post": {
        "tags": ["1. Passkey 登录【新增】"],
        "summary": "【新增】Passkey 登录 第1步",
        "description": "使用时机：登录页点「passkey login」。无请求体；返回 discoverable credential 的 request options JSON(string)，直接交给 navigator.credentials.get()。",
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultString" }, "example": { "success": true, "code": "200", "msg": "Success", "data": "{\"challenge\":\"...\",\"rpId\":\"...\"}" } } } } }
      }
    },
    "/user/login/passkey/finish": {
      "post": {
        "tags": ["1. Passkey 登录【新增】"],
        "summary": "【新增】Passkey 登录 第2步",
        "description": "使用时机：系统面板 get 到 credentialJson 后。返回 LOGIN 业务的 2 分钟临时票据。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyLoginFinishVo" }, "example": { "credentialJson": "{\"id\":\"...\",\"response\":{...},\"type\":\"public-key\"}" } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVerifyTicket" }, "example": { "success": true, "code": "200", "msg": "Success", "data": { "passkeyVerifyToken": "xxx", "businessType": "LOGIN", "businessId": "" } } } } } }
      }
    },
    "/user/login/passkey/token": {
      "post": {
        "tags": ["1. Passkey 登录【新增】"],
        "summary": "【修改】Passkey 登录 第3步（含 2FA 兜底）",
        "description": "使用时机：拿到 passkeyVerifyToken 后换登录态。passkeyVerifyToken 有效期 5 分钟。\n三种结果：\n1) 低风险 → 消费票据、签发 Sa-Token，登录成功。\n2) 命中 LOGIN 二次风控 → 返回 code=RISK_NEED_TWO_FA + risk（含 consoleNo、recommendTwoFaType、extData.loginAccount 明文账号）；票据不消费仍有效。前端用 loginAccount 走发码(sendMessageCode)+验码(/security/verify, messageType=LOGIN, riskConsoleNo)，再带 passkeyVerifyToken + riskConsoleNo 重试本接口。\n3) 命中 REJECT 等硬拦截 → 直接拒绝。",
        "parameters": [
          { "name": "deviceId", "in": "header", "required": false, "schema": { "type": "string" }, "description": "设备唯一标识，可选" },
          { "name": "platform", "in": "header", "required": false, "schema": { "type": "string", "enum": ["iOS", "Android", "Web"] }, "description": "客户端平台。枚举：iOS/Android/Web" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyLoginTokenVo" }, "examples": { "首次": { "value": { "passkeyVerifyToken": "xxx", "riskConsoleNo": null } }, "2FA后重试": { "value": { "passkeyVerifyToken": "xxx", "riskConsoleNo": "RC777" } } } } } },
        "responses": { "200": { "description": "登录成功 / 需二次验证", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultSaToken" }, "examples": { "登录成功": { "value": { "success": true, "code": "200", "msg": "Success", "data": { "tokenName": "3world-token", "tokenValue": "xxxx" } } }, "需二次验证(带账号)": { "value": { "success": false, "code": "RISK_NEED_TWO_FA", "msg": "需要完成二次验证后才能继续交易", "data": null, "risk": { "consoleNo": "RC777", "actionType": "TWO_FA", "recommendTwoFaType": "PHONE", "extData": { "loginAccount": { "email": "user@demo.com", "areaCode": "+86", "phoneNumber": "13800000000" } } } } } } } } } }
      }
    },
    "/security/passkey/register/start": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【新增】绑定 第1步",
        "description": "使用时机：安全中心点「Add New Passkey」，且已通过 BIND_PASSKEY 2FA。返回 creation options JSON(string)。前置注解 @SaCheckSafe(\"BIND_PASSKEY\")。",
        "security": [{ "SaToken": [] }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultString" }, "example": { "success": true, "code": "200", "msg": "Success", "data": "{\"rp\":{...},\"challenge\":\"...\"}" } } } } }
      }
    },
    "/security/passkey/register/finish": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【新增】绑定 第2步",
        "description": "使用时机：系统面板 create 出 credentialJson 后完成绑定入库。前置注解 @SaCheckSafe(\"BIND_PASSKEY\")。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyRegisterFinishVo" }, "example": { "credentialJson": "{\"id\":\"...\",\"response\":{...},\"type\":\"public-key\"}", "deviceName": "iPhone - 20260707" } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVoid" }, "example": { "success": true, "code": "200", "msg": "Success", "data": null } } } } }
      }
    },
    "/security/passkey/list": {
      "get": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【新增】Passkey 列表",
        "description": "使用时机：进入 Passkey 管理页加载已绑定列表（仅 ACTIVE，账号级：含各设备各一把）。",
        "security": [{ "SaToken": [] }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultCredentialList" }, "example": { "success": true, "code": "200", "msg": "Success", "data": [ { "credentialId": "AbC123", "deviceName": "Chrome/Mac - 20260702", "signCount": 5, "createTime": "2026-07-02T10:00:00", "lastUsedTime": "2026-07-07T09:00:00" } ] } } } } }
      }
    },
    "/security/passkey/update-name": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【新增】编辑 Passkey 名称",
        "description": "使用时机：列表点编辑改名。无需 2FA；名称非空、≤30 字符；仅本人 ACTIVE 凭证。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyUpdateNameVo" }, "example": { "credentialId": "AbC123", "deviceName": "我的 MacBook" } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVoid" }, "example": { "success": true, "code": "200", "msg": "Success", "data": null } } } } }
      }
    },
    "/security/passkey/revoke": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【新增】撤销 Passkey",
        "description": "使用时机：列表点删除并二次确认（含提现冻结 24h 文案），且已通过 REVOKE_PASSKEY 2FA。前置注解 @SaCheckSafe(\"REVOKE_PASSKEY\")。删除成功后后端设提现 24h 限制。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyRevokeVo" }, "example": { "credentialId": "AbC123" } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVoid" }, "example": { "success": true, "code": "200", "msg": "Success", "data": null } } } } }
      }
    },
    "/security/passkey/verify/start": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【修改】业务验证 第1步（本次加 riskConsoleNo）",
        "description": "使用时机：高风险业务返回 recommendTwoFaType=PASSKEY 时第1步。传 riskConsoleNo=风控单写回模式(本次新增)；不传=safe 模式。返回 assertion options JSON(string)。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyVerifyStartVo" }, "examples": { "风控单写回模式": { "value": { "businessType": "WITHDRAW", "businessId": "WD123456", "riskConsoleNo": "RC123456" } }, "safe模式": { "value": { "businessType": "SEND", "businessId": "SD888" } } } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultString" }, "example": { "success": true, "code": "200", "msg": "Success", "data": "{\"challenge\":\"...\",\"allowCredentials\":[...]}" } } } } }
      }
    },
    "/security/passkey/verify/finish": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【修改】业务验证 第2步（本次加 riskConsoleNo 写回）",
        "description": "使用时机：系统面板 get 到 credentialJson 后。传 riskConsoleNo=校验断言并写回风控单(PASSKEY/SUCCESS)，随后带同一 consoleNo 重试业务接口放行(本次新增)；不传=打开 Passkey safe。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyVerifyFinishVo" }, "examples": { "风控单写回模式": { "value": { "credentialJson": "{\"id\":\"...\",\"response\":{...},\"type\":\"public-key\"}", "riskConsoleNo": "RC123456" } }, "safe模式": { "value": { "credentialJson": "{\"id\":\"...\",\"response\":{...},\"type\":\"public-key\"}" } } } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVerifyResult" }, "example": { "success": true, "code": "200", "msg": "Success", "data": { "verified": true, "businessType": "WITHDRAW", "businessId": "WD123456" } } } } } }
      }
    },
    "/security/passkey/verify/token/finish": {
      "post": {
        "tags": ["2. Passkey 管理【新增/修改】"],
        "summary": "【新增】业务验证 第2步（票据模式）",
        "description": "使用时机：safe/票据模式，返回 120 秒一次性 passkeyVerifyToken 供业务接口消费。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyVerifyFinishVo" }, "example": { "credentialJson": "{\"id\":\"...\",\"response\":{...},\"type\":\"public-key\"}" } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVerifyTicket" }, "example": { "success": true, "code": "200", "msg": "Success", "data": { "passkeyVerifyToken": "xxx", "businessType": "SEND", "businessId": "SD888" } } } } } }
      }
    },
    "/user/getInfo": {
      "get": {
        "tags": ["3. 2FA 与账号登录【历史复用】"],
        "summary": "【修改】获取用户信息（本次加 passkeyStatus）",
        "description": "使用时机：进入「我的/安全中心」加载用户信息。本次新增 passkeyStatus：前端据此显示「推荐」文案、以及高风险验证是否优先唤起 Passkey。注意 passkeyStatus 是账号级(名下任一 ACTIVE 即为 1)，非本设备级。",
        "security": [{ "SaToken": [] }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultUserInfo" }, "example": { "success": true, "code": "200", "msg": "Success", "data": { "userId": 10001, "isGoogleAuthBound": true, "passkeyStatus": 1 } } } } } }
      }
    },
    "/security/verify": {
      "post": {
        "tags": ["3. 2FA 与账号登录【历史复用】"],
        "summary": "【历史复用】传统 2FA 验证",
        "description": "使用时机：1) 绑定 passkey 前置(messageType=BIND_PASSKEY，成功后 openSafe)；2) 删除 passkey 前置(REVOKE_PASSKEY)；3) 高风险业务 passkey 失败兜底(type 选 EMAIL/PHONE/GOOGLE、messageType=业务、带 riskConsoleNo，写回同一风控单后重试)。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyVo" }, "examples": { "绑定passkey前置": { "value": { "type": "GOOGLE", "messageType": "BIND_PASSKEY", "code": "123456" } }, "删除passkey前置": { "value": { "type": "GOOGLE", "messageType": "REVOKE_PASSKEY", "code": "123456" } }, "passkey兜底切换": { "value": { "type": "EMAIL", "messageType": "WITHDRAW", "code": "123456", "riskConsoleNo": "RC123456" } } } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultBoolean" }, "example": { "success": true, "code": "200", "msg": "Success", "data": true } } } } }
      }
    },
    "/user/login/doLogin": {
      "post": {
        "tags": ["3. 2FA 与账号登录【历史复用】"],
        "summary": "【历史复用】账号密码登录",
        "description": "使用时机：passkey 登录找不到可用凭证时兜底。若命中登录风控返回 code=RISK_NEED_TWO_FA + risk.consoleNo，走 /security/verify(messageType=LOGIN) 后带同一 consoleNo 重试。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DoLoginVo" }, "example": { "email": "user@demo.com", "password": "******", "riskConsoleNo": null } } } },
        "responses": { "200": { "description": "成功或需二次验证", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultSaToken" }, "examples": { "登录成功": { "value": { "success": true, "code": "200", "msg": "Success", "data": { "tokenName": "3world-token", "tokenValue": "xxx" } } }, "需二次验证": { "value": { "success": false, "code": "RISK_NEED_TWO_FA", "msg": "需要完成二次验证", "data": null, "risk": { "consoleNo": "RC777", "actionType": "TWO_FA", "recommendTwoFaType": "GOOGLE" } } } } } } } }
      }
    },
    "/api/sendreceive/send": {
      "post": {
        "tags": ["4. 业务接口·触发风控【历史复用】"],
        "summary": "【历史复用】转账/出金（SEND，触发风控）",
        "description": "使用时机：发起转账/出金。命中风控返回 code=RISK_NEED_TWO_FA + risk(consoleNo, recommend=PASSKEY) → passkey verify/start+finish(带 riskConsoleNo)写回 → 带同一 consoleNo 重试放行。仅展示风控相关字段，其余业务字段以实际为准。",
        "security": [{ "SaToken": [] }],
        "parameters": [ { "name": "deviceId", "in": "header", "required": false, "schema": { "type": "string" }, "description": "设备唯一标识，可选" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BusinessRiskRequest" }, "example": { "riskConsoleNo": null, "riskConsoleRequestDTO": { "bizType": "TRANSFER" }, "payeeInfo": "…", "money": { "amount": "100" } } } } },
        "responses": { "200": { "description": "成功或命中风控", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultBusiness" }, "examples": { "命中风控": { "value": { "success": false, "code": "RISK_NEED_TWO_FA", "msg": "需要完成二次验证", "data": null, "risk": { "consoleNo": "RC123456", "actionType": "TWO_FA", "recommendTwoFaType": "PASSKEY" } } }, "放行成功": { "value": { "success": true, "code": "200", "msg": "Success", "data": { "orderNo": "SD888" } } } } } } } }
      }
    },
    "/api/kyt/screening/orders": {
      "post": {
        "tags": ["4. 业务接口·触发风控【历史复用】"],
        "summary": "【历史复用】KYT 筛查扣费（KYT，触发风控）",
        "description": "使用时机：发起需扣费的 KYT 地址筛查。命中风控与转账同理。提现/出金(on-chain /api/onchain/order，businessType=WITHDRAW)走同一套模式。",
        "security": [{ "SaToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BusinessRiskRequest" }, "example": { "riskConsoleNo": null, "riskConsoleRequestDTO": { "bizType": "KYT" }, "address": "0x…" } } } },
        "responses": { "200": { "description": "成功或命中风控", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultBusiness" }, "examples": { "命中风控": { "value": { "success": false, "code": "RISK_NEED_TWO_FA", "msg": "需要完成二次验证", "risk": { "consoleNo": "RC654321", "actionType": "TWO_FA", "recommendTwoFaType": "PASSKEY" } } }, "放行成功": { "value": { "success": true, "code": "200", "msg": "Success", "data": { "orderNo": "KYT001" } } } } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SaToken": { "type": "apiKey", "in": "header", "name": "3world-token", "description": "登录返回的 tokenValue（登录态令牌）" }
    },
    "schemas": {
      "RiskConsole": {
        "type": "object",
        "description": "触发风控时经 Result.risk 返回的完整参数（对应后端 RiskConsoleResponseDTO）",
        "properties": {
          "consoleNo": { "type": "string", "description": "风控单号；后续 2FA/passkey 验证与业务重试都带它" },
          "consoleStatus": { "type": "string", "enum": ["INIT", "PROCESS", "PENDING", "SUCCESS", "REJECT"], "description": "风控状态。INIT 咨询/PROCESS 处理中/PENDING 待处理(人工或2FA)/SUCCESS 通过/REJECT 拒绝" },
          "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"], "description": "风险等级。LOW 低/MEDIUM 中/HIGH 高" },
          "riskScore": { "type": "integer", "description": "风险分数 0-100" },
          "actionType": { "type": "string", "enum": ["PASS", "TWO_FA", "PENDING", "REJECT"], "description": "处置动作。PASS 放行/TWO_FA 二次验证/PENDING 人工审核/REJECT 拒绝" },
          "needTwoFa": { "type": "boolean", "description": "是否需要二次验证。true 需要/false 不需要" },
          "recommendTwoFaType": { "type": "string", "enum": ["PHONE", "EMAIL", "GOOGLE", "PASSKEY"], "description": "推荐的 2FA 方式。PHONE 手机/EMAIL 邮箱/GOOGLE 谷歌验证器/PASSKEY 通行密钥" },
          "needTicket": { "type": "boolean", "description": "是否需要人工工单。true 需要人工审核" },
          "ticketId": { "type": "integer", "format": "int64", "nullable": true, "description": "人工工单 ID，无则 null" },
          "hitStrategies": { "type": "array", "items": { "type": "string" }, "description": "命中的策略编码列表，如 [ACCOUNT_SECURITY_STUFFING_001]" },
          "riskTags": { "type": "array", "items": { "type": "string" }, "description": "风险标签，如 [ACCOUNT_SECURITY]" },
          "riskReasons": { "type": "array", "items": { "type": "string" }, "description": "风险原因文案列表，可直接展示" },
          "mainStrategyKey": { "type": "string", "description": "主拦截策略的多语言 key，如 risk.strategy.account_security_stuffing_001" },
          "degraded": { "type": "boolean", "description": "是否为降级返回。true 降级/false 正常" },
          "extData": { "$ref": "#/components/schemas/RiskExtData" }
        }
      },
      "RiskExtData": {
        "type": "object",
        "description": "风控扩展数据（extData），字段随场景而变，前端按需读取",
        "properties": {
          "loginResult": { "type": "string", "description": "登录结果，如 SUCCESS（登录场景）" },
          "loginType": { "type": "string", "description": "登录方式，如 PASSKEY / PASSWORD（登录场景）" },
          "strategiesWithTwoFa": { "type": "array", "items": { "type": "string" }, "description": "命中且要求 2FA 的策略推荐类型集合，如 [PHONE]" },
          "twoFaStrategies": { "type": "array", "items": { "type": "string" }, "description": "触发 2FA 的策略编码集合" },
          "ipGeolocation": { "type": "object", "description": "IP 归属地信息（loc/country/city/region/org/timezone/postal）" },
          "loginAccount": { "$ref": "#/components/schemas/LoginAccount" },
          "twoFaVerifyDetail": { "type": "object", "description": "2FA 验证明细（verifyType/verifyResult/verifyTime 等），验证成功后写回" }
        }
      },
      "LoginAccount": {
        "type": "object",
        "description": "passkey 登录命中 LOGIN 二次风控时回传的账号信息，供前端复用发码/验码接口（明文）",
        "properties": {
          "email": { "type": "string", "nullable": true, "description": "邮箱，可能为空" },
          "areaCode": { "type": "string", "nullable": true, "description": "手机区号，可能为空" },
          "phoneNumber": { "type": "string", "nullable": true, "description": "手机号，可能为空" }
        }
      },
      "ResultBase": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "是否成功。true 成功/false 失败" },
          "code": { "type": "string", "description": "业务码。200 成功；RISK_NEED_TWO_FA 需二次验证；403 二级认证过期/未开启；PASSKEY_NOT_BOUND 未绑定；PASSKEY_NOT_SUPPORTED 设备不支持；PASSKEY_VERIFY_FAILED 验证失败；PASSKEY_CHALLENGE_EXPIRED 挑战过期；PASSKEY_VERIFY_TOKEN_INVALID 票据无效；PASSKEY_RISK_CONSOLE_INVALID 与风控单不匹配" },
          "msg": { "type": "string", "description": "提示文案" },
          "risk": { "$ref": "#/components/schemas/RiskConsole" },
          "timestamp": { "type": "integer", "format": "int64", "description": "响应时间戳(ms)" },
          "isLogin": { "type": "boolean", "description": "是否已登录(部分接口用)" },
          "userId": { "type": "integer", "format": "int64", "description": "用户 ID(部分接口回填)" }
        }
      },
      "ResultVoid": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "type": "object", "nullable": true, "description": "无返回体，固定 null" } } } ] },
      "ResultString": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "type": "string", "description": "WebAuthn options 的 JSON 字符串，直接交给系统面板" } } } ] },
      "ResultBoolean": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "type": "boolean", "description": "验证结果。true 通过/false 未通过" } } } ] },
      "ResultBusiness": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "type": "object", "nullable": true, "description": "业务数据(放行时返回，命中风控时为 null 见 risk)" } } } ] },
      "ResultCredentialList": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PasskeyCredentialDTO" }, "description": "已绑定的 passkey 列表" } } } ] },
      "ResultVerifyResult": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PasskeyVerifyResultDTO" } } } ] },
      "ResultVerifyTicket": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PasskeyVerifyTicketDTO" } } } ] },
      "ResultSaToken": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/SaTokenInfo" } } } ] },
      "ResultUserInfo": { "allOf": [ { "$ref": "#/components/schemas/ResultBase" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UserInfoBrief" } } } ] },
      "PasskeyRegisterFinishVo": {
        "type": "object",
        "required": ["credentialJson"],
        "properties": {
          "credentialJson": { "type": "string", "description": "navigator.credentials.create() 返回的 JSON 字符串(入参)" },
          "deviceName": { "type": "string", "description": "设备名，可选；不传由后端默认命名(设备/浏览器+日期)" }
        }
      },
      "PasskeyUpdateNameVo": {
        "type": "object",
        "required": ["credentialId", "deviceName"],
        "properties": {
          "credentialId": { "type": "string", "description": "凭证 ID(base64url)，指定要改名的 passkey" },
          "deviceName": { "type": "string", "maxLength": 30, "description": "新名称，非空、≤30 字符" }
        }
      },
      "PasskeyRevokeVo": {
        "type": "object",
        "required": ["credentialId"],
        "properties": { "credentialId": { "type": "string", "description": "凭证 ID(base64url)，指定要删除的 passkey" } }
      },
      "PasskeyVerifyStartVo": {
        "type": "object",
        "required": ["businessType"],
        "properties": {
          "businessType": { "type": "string", "enum": ["WITHDRAW", "KYT", "SEND", "CARD_DETAILS"], "description": "业务类型。WITHDRAW 提现/KYT 筛查扣费/SEND 转账出金/CARD_DETAILS 卡信息" },
          "businessId": { "type": "string", "description": "业务单号/请求摘要，可选；与业务接口消费时保持一致" },
          "riskConsoleNo": { "type": "string", "description": "风控单号，可选；传入=风控单写回模式，不传=safe 模式" }
        }
      },
      "PasskeyVerifyFinishVo": {
        "type": "object",
        "required": ["credentialJson"],
        "properties": {
          "credentialJson": { "type": "string", "description": "navigator.credentials.get() 返回的 JSON 字符串" },
          "riskConsoleNo": { "type": "string", "description": "风控单号，可选；与 verify/start 保持一致触发写回" }
        }
      },
      "PasskeyLoginFinishVo": {
        "type": "object",
        "required": ["credentialJson"],
        "properties": { "credentialJson": { "type": "string", "description": "navigator.credentials.get() 返回的 JSON 字符串" } }
      },
      "PasskeyLoginTokenVo": {
        "type": "object",
        "required": ["passkeyVerifyToken"],
        "properties": {
          "passkeyVerifyToken": { "type": "string", "description": "登录 finish 返回的一次性票据，有效期 5 分钟" },
          "riskConsoleNo": { "type": "string", "nullable": true, "description": "风控单号(继承自 RiskVo)。首次为空；命中 LOGIN 二次风控、完成 2FA 后重试时回填" }
        }
      },
      "VerifyVo": {
        "type": "object",
        "required": ["type", "messageType", "code"],
        "properties": {
          "type": { "type": "string", "enum": ["PHONE", "EMAIL", "GOOGLE"], "description": "验证方式。PHONE 手机/EMAIL 邮箱/GOOGLE 谷歌验证器" },
          "messageType": { "type": "string", "enum": ["BIND_PASSKEY", "REVOKE_PASSKEY", "LOGIN", "WITHDRAW", "KYT", "SEND"], "description": "场景。BIND_PASSKEY 绑定/REVOKE_PASSKEY 删除/LOGIN 登录/WITHDRAW 提现/KYT 筛查/SEND 转账。决定盖哪个 safe 或写回哪张风控单" },
          "code": { "type": "string", "description": "验证码" },
          "riskConsoleNo": { "type": "string", "description": "风控单号，风控触发的 2FA 兜底时传" },
          "email": { "type": "string", "description": "邮箱，未登录场景传" },
          "areaCode": { "type": "string", "description": "手机区号，未登录场景传" },
          "phoneNumber": { "type": "string", "description": "手机号，未登录场景传" }
        }
      },
      "DoLoginVo": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "description": "邮箱，与手机二选一" },
          "areaCode": { "type": "string", "description": "手机区号，与邮箱二选一" },
          "phoneNumber": { "type": "string", "description": "手机号，与邮箱二选一" },
          "password": { "type": "string", "description": "登录密码" },
          "riskConsoleNo": { "type": "string", "nullable": true, "description": "风控单号；首次为空，2FA 后重试时带回" }
        }
      },
      "BusinessRiskRequest": {
        "type": "object",
        "description": "触发风控的业务请求(仅列风控相关字段，其余业务字段以各接口为准)",
        "properties": {
          "riskConsoleNo": { "type": "string", "nullable": true, "description": "风控单号；首次为空，2FA 通过后重试时带回" },
          "riskConsoleRequestDTO": { "type": "object", "description": "风控上下文，含 bizType(TRANSFER/WITHDRAW/KYT 等)，部分字段后端填充" }
        }
      },
      "PasskeyCredentialDTO": {
        "type": "object",
        "properties": {
          "credentialId": { "type": "string", "description": "凭证 ID(base64url)，唯一标识一把 passkey" },
          "deviceName": { "type": "string", "description": "设备名，如 iPhone、Chrome/Mac - 20260702" },
          "signCount": { "type": "integer", "format": "int64", "description": "签名计数，防克隆" },
          "createTime": { "type": "string", "format": "date-time", "description": "绑定时间" },
          "lastUsedTime": { "type": "string", "format": "date-time", "description": "最近使用时间" }
        }
      },
      "PasskeyVerifyResultDTO": {
        "type": "object",
        "properties": {
          "verified": { "type": "boolean", "description": "是否验证通过。true 通过" },
          "businessType": { "type": "string", "enum": ["WITHDRAW", "KYT", "SEND", "CARD_DETAILS", "LOGIN"], "description": "业务类型，回显 start 时传入值" },
          "businessId": { "type": "string", "description": "业务单号，回显" }
        }
      },
      "PasskeyVerifyTicketDTO": {
        "type": "object",
        "properties": {
          "passkeyVerifyToken": { "type": "string", "description": "一次性票据，有效期 120 秒，业务接口消费后失效" },
          "businessType": { "type": "string", "enum": ["WITHDRAW", "KYT", "SEND", "CARD_DETAILS", "LOGIN"], "description": "业务类型。登录场景为 LOGIN" },
          "businessId": { "type": "string", "description": "业务单号；登录场景为空串" }
        }
      },
      "SaTokenInfo": {
        "type": "object",
        "properties": {
          "tokenName": { "type": "string", "example": "3world-token", "description": "令牌头名，固定 3world-token" },
          "tokenValue": { "type": "string", "description": "登录令牌，后续请求放入同名请求头" }
        }
      },
      "UserInfoBrief": {
        "type": "object",
        "description": "用户信息(仅列 passkey 相关字段，其余省略)",
        "properties": {
          "userId": { "type": "integer", "description": "用户 ID" },
          "isGoogleAuthBound": { "type": "boolean", "description": "是否绑定谷歌验证器。true 已绑定/false 未绑定" },
          "passkeyStatus": { "type": "integer", "enum": [0, 1], "description": "Passkey 绑定状态(账号级)。0 未绑定/1 已绑定" }
        }
      }
    }
  }
}
